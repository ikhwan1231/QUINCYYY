<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools" >

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/stern"
        android:label="QUINCY"
        android:roundIcon="@drawable/stern"
        android:supportsRtl="true"
        android:theme="@style/Theme.Quincy" >

        <!-- Splash Activity sebagai Launcher utama -->
        <activity
            android:name="com.example.quincy.UI.QUINCY.Main.splash"
            android:exported="true"
            android:windowSoftInputMode="adjustResize" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- MainActivity -->
        <activity
            android:name="com.example.quincy.UI.QUINCY.Main.MainActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- See More Activity -->
        <activity
            android:name="com.example.quincy.UI.QUINCY.Main.SeeMoreActivity"
            android:exported="false" />

    </application>

</manifest>