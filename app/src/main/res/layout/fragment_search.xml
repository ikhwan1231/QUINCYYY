<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Bar duwur -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:text="@string/search_results_title"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/ivGenreLogo"
            android:layout_width="43dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_genre_logo"
            android:padding="8dp"
            android:src="@drawable/ic_search_genre" />
    </LinearLayout>

    <!-- Bar cari -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_search_bar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_search"
            app:tint="@color/text_secondary"
            xmlns:app="http://schemas.android.com/apk/res-auto"
            >
        </ImageView>

        <EditText
            android:id="@+id/etSearch"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginHorizontal="8dp"
            android:background="@null"
            android:hint="@string/cari_judul"
            android:inputType="text"
            android:singleLine="true"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"
            android:textSize="13sp"
            >
        </EditText>

        <ImageView
            android:id="@+id/btnClear"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/baseline_close_24"
            app:tint="@color/text_secondary"
            xmlns:app="http://schemas.android.com/apk/res-auto"
            >
        </ImageView>

    </LinearLayout>

    <!-- JUMLAH HASIL -->
    <TextView
        android:id="@+id/tvJumlahHasil"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/total_pencarian"
        android:textColor="@color/text_secondary"
        android:textSize="11sp"
        >
    </TextView>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvSearch"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="10dp"
        android:clipToPadding="false"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

</LinearLayout>
